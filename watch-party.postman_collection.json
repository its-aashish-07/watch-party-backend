{
  "info": {
    "name": "SyncRoom Watch Party API — Authentication + MongoDB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "roomId", "value": "WP-ROOMID" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const data = pm.response.json();", "if (data.ok) pm.collectionVariables.set('token', data.data.token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"strong-password\"\n}" },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const data = pm.response.json();", "if (data.ok) pm.collectionVariables.set('token', data.data.token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"strong-password\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Create room",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const data = pm.response.json();", "if (data.ok) pm.collectionVariables.set('roomId', data.data.room.id);"] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Friday Movie Night\",\n  \"videoUrl\": \"https://www.youtube.com/watch?v=LXb3EKWsInQ\"\n}" },
            "url": "{{baseUrl}}/api/rooms"
          }
        },
        {
          "name": "Get room",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}"
          }
        }
      ]
    }
  ]
}
